{
  "name": "orthanc-analytics-website",
  "private": true,
  "description": "Orthanc Analytics website: static, bilingual (EN/IT), built with a zero-dependency Node script.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:strict": "node build.mjs --strict",
    "preview": "node build.mjs && node tools/serve.mjs",
    "map": "node tools/build-dotmap.mjs",
    "images": "node tools/render-images.mjs"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "playwright-core": "^1.63.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
